{
  "manifest_version": 3,
  "name": "Eksperix Bridge",
  "description": "UAVT adres sorgusu, belediye e-imar durumu ve emsal ilan bilgilerini Eksperix formuna otomatik aktarır.",
  "version": "0.6.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://adres.nvi.gov.tr/*",
    "*://*.bel.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://eksperi-x.vercel.app/*",
    "*://*.sahibinden.com/*",
    "*://*.hepsiemlak.com/*",
    "*://*.emlakjet.com/*",
    "*://*.zingat.com/*",
    "*://*.remax.com.tr/*",
    "*://*.turyap.com.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Eksperix Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://eksperi-x.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
